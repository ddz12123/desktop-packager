package main

import (
	"archive/zip"
	"encoding/binary"
	"encoding/json"
	"fmt"
	"io"
	"io/fs"
	"os"
	"path/filepath"
	"strings"
)

const (
	resourceFooterMagic uint32 = 0x5245534F // "RESO"
	footerSize                 = 8
)

type resourceFooter struct {
	Magic  uint32
	Offset uint32
}

// resourceExe holds the opened executable so zip entries can be read lazily.
// Intentionally kept open for process lifetime.
var resourceExe *os.File

func loadResources() (fs.FS, map[string][]byte, error) {
	exePath, err := os.Executable()
	if err != nil {
		return nil, nil, fmt.Errorf("获取可执行文件路径失败: %w", err)
	}

	f, err := os.Open(exePath)
	if err != nil {
		return nil, nil, fmt.Errorf("打开可执行文件失败: %w", err)
	}

	stat, err := f.Stat()
	if err != nil {
		f.Close()
		return nil, nil, fmt.Errorf("获取文件信息失败: %w", err)
	}
	fileSize := stat.Size()
	if fileSize < int64(footerSize) {
		f.Close()
		return nil, nil, fmt.Errorf("可执行文件过小，未找到嵌入的资源")
	}

	var footer resourceFooter
	if _, err := f.Seek(-int64(footerSize), io.SeekEnd); err != nil {
		f.Close()
		return nil, nil, fmt.Errorf("定位 footer 失败: %w", err)
	}
	if err := binary.Read(f, binary.LittleEndian, &footer); err != nil {
		f.Close()
		return nil, nil, fmt.Errorf("读取 footer 失败: %w", err)
	}
	if footer.Magic != resourceFooterMagic {
		f.Close()
		return nil, nil, fmt.Errorf("未找到嵌入的资源（magic 不匹配）")
	}

	zipOffset := int64(footer.Offset)
	zipSize := fileSize - zipOffset - int64(footerSize)
	if zipOffset < 0 || zipSize <= 0 || zipOffset+zipSize > fileSize {
		f.Close()
		return nil, nil, fmt.Errorf("资源偏移量无效")
	}

	section := io.NewSectionReader(f, zipOffset, zipSize)
	zr, err := zip.NewReader(section, zipSize)
	if err != nil {
		f.Close()
		return nil, nil, fmt.Errorf("解析资源 zip 失败: %w", err)
	}

	resourceExe = f

	distFiles := make(map[string]*zip.File)
	configFiles := make(map[string][]byte)

	for _, file := range zr.File {
		name := file.Name
		if strings.Contains(name, "..") {
			continue
		}
		if name == "proxy_config.json" || name == "app_config.json" {
			rc, err := file.Open()
			if err != nil {
				continue
			}
			data, err := io.ReadAll(rc)
			rc.Close()
			if err != nil {
				continue
			}
			configFiles[name] = data
			continue
		}
		if strings.HasPrefix(name, "dist/") {
			if strings.HasSuffix(name, "/") {
				continue
			}
			relName := strings.TrimPrefix(name, "dist/")
			if relName != "" {
				distFiles[relName] = file
			}
		}
	}

	// exe 同目录的外置配置优先于内置资源，便于不发版调整窗口参数或代理目标。
	overrideWithExternalConfig(configFiles, "proxy_config.json")
	overrideWithExternalConfig(configFiles, "app_config.json")

	if configFiles["proxy_config.json"] == nil {
		configFiles["proxy_config.json"] = []byte("{\"rules\": []}")
	}
	if configFiles["app_config.json"] == nil {
		configFiles["app_config.json"] = []byte("{\"width\": 1024, \"height\": 768}")
	}

	return NewZipFS(distFiles), configFiles, nil
}

// overrideWithExternalConfig 用 exe 同目录的同名配置文件覆盖内置配置。
// 文件不存在或不是合法 JSON 时忽略，继续使用内置配置。
func overrideWithExternalConfig(configFiles map[string][]byte, name string) {
	exePath, err := os.Executable()
	if err != nil {
		return
	}
	data, err := os.ReadFile(filepath.Join(filepath.Dir(exePath), name))
	if err != nil || len(data) == 0 || !json.Valid(data) {
		return
	}
	configFiles[name] = data
}
