package main

import (
	"net"
	"net/http"
	"net/http/httputil"
	"net/url"
	"strings"
	"time"
)

func newProxyTransport() http.RoundTripper {
	return &http.Transport{
		Proxy: http.ProxyFromEnvironment,
		DialContext: (&net.Dialer{
			Timeout:   30 * time.Second,
			KeepAlive: 30 * time.Second,
		}).DialContext,
		ForceAttemptHTTP2:     true,
		MaxIdleConns:          100,
		IdleConnTimeout:       90 * time.Second,
		TLSHandshakeTimeout:   10 * time.Second,
		ExpectContinueTimeout: 1 * time.Second,
		ResponseHeaderTimeout: 60 * time.Second,
	}
}

// registerProxyRules 按 nginx location + proxy_pass 语义注册代理规则。
// 路径算法（MatchLocation / ResolveUpstreamPath / NormalizeLocation）由
// cmd/build-base 从 internal/nginxproxy 复制进来，与打包工具共用同一份实现。
func registerProxyRules(mux *http.ServeMux, rules []ProxyRule) {
	for _, rule := range rules {
		if !rule.Enabled {
			continue
		}
		location := NormalizeLocation(rule.Path)
		if location == "" {
			continue
		}
		target, err := url.Parse(strings.TrimSpace(rule.Target))
		if err != nil || target.Scheme == "" || target.Host == "" {
			continue
		}

		loc := location
		rewrite := strings.TrimSpace(rule.Rewrite)
		targetURL := *target
		proxy := httputil.NewSingleHostReverseProxy(&targetURL)
		proxy.Transport = newProxyTransport()
		proxy.FlushInterval = 100 * time.Millisecond
		proxy.ErrorHandler = func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, "Bad Gateway: "+err.Error(), http.StatusBadGateway)
		}

		proxy.Director = func(req *http.Request) {
			// Capture original host before rewriting for upstream.
			originalHost := req.Host
			if originalHost == "" {
				originalHost = req.Header.Get("Host")
			}

			outPath := ResolveUpstreamPath(loc, req.URL.Path, targetURL.Path, rewrite)
			req.URL.Scheme = targetURL.Scheme
			req.URL.Host = targetURL.Host
			req.URL.Path = outPath
			req.URL.RawPath = ""
			if targetURL.RawQuery != "" {
				if req.URL.RawQuery == "" {
					req.URL.RawQuery = targetURL.RawQuery
				} else {
					req.URL.RawQuery = targetURL.RawQuery + "&" + req.URL.RawQuery
				}
			}
			// nginx proxy_set_header Host $proxy_host
			req.Host = targetURL.Host

			if clientIP, _, err := net.SplitHostPort(req.RemoteAddr); err == nil {
				if prior := req.Header.Get("X-Forwarded-For"); prior == "" {
					req.Header.Set("X-Forwarded-For", clientIP)
				} else {
					req.Header.Set("X-Forwarded-For", prior+", "+clientIP)
				}
				if req.Header.Get("X-Real-IP") == "" {
					req.Header.Set("X-Real-IP", clientIP)
				}
			} else if req.RemoteAddr != "" {
				if req.Header.Get("X-Forwarded-For") == "" {
					req.Header.Set("X-Forwarded-For", req.RemoteAddr)
				}
				if req.Header.Get("X-Real-IP") == "" {
					req.Header.Set("X-Real-IP", req.RemoteAddr)
				}
			}

			if req.Header.Get("X-Forwarded-Proto") == "" {
				if req.TLS != nil {
					req.Header.Set("X-Forwarded-Proto", "https")
				} else {
					req.Header.Set("X-Forwarded-Proto", "http")
				}
			}
			if req.Header.Get("X-Forwarded-Host") == "" && originalHost != "" {
				req.Header.Set("X-Forwarded-Host", originalHost)
			}
		}

		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if !MatchLocation(loc, r.URL.Path) {
				http.NotFound(w, r)
				return
			}
			proxy.ServeHTTP(w, r)
		})
		registerLocation(mux, loc, handler)
	}
}

func registerLocation(mux *http.ServeMux, location string, handler http.Handler) {
	// Register both exact and prefix forms so /api and /api/ both reach the proxy,
	// matching common nginx location convenience for desktop apps.
	if strings.HasSuffix(location, "/") {
		mux.Handle(location, handler)
		exact := strings.TrimSuffix(location, "/")
		if exact != "" {
			mux.Handle(exact, handler)
		}
		return
	}
	mux.Handle(location, handler)
	mux.Handle(location+"/", handler)
}
